rules_version = '2';

// Projeto Live — regras do Firestore (Firebase › Firestore Database › Regras: cole tudo e Publique).
// Cada culto só pode ser lido e mexido pela conta dona dele (campo "owner").
service cloud.firestore {
  match /databases/{database}/documents {
    match /cultos/{cultoId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;

      // Histórico das versões publicadas.
      match /versoes/{n} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/cultos/$(cultoId)).data.owner == request.auth.uid;
      }
    }

    // Culto ao vivo: o que está no telão agora (a Projeção escreve) e os recados e sugestões.
    match /aoVivo/{cultoId} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;

      match /eventos/{id} {
        allow read, update: if request.auth != null
          && get(/databases/$(database)/documents/aoVivo/$(cultoId)).data.owner == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.owner == request.auth.uid
          && get(/databases/$(database)/documents/aoVivo/$(cultoId)).data.owner == request.auth.uid;
      }
    }

    // Banco de músicas da igreja: a Projeção sobe a biblioteca; o diretor busca e cadastra novas.
    match /musicas/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // Equipe de mídia: cada pessoa é um documento com um código longo e aleatório (o link pessoal).
    // Quem tem o link (sem login) lê o próprio documento e só pode mudar as respostas, os dias em que
    // não pode e quando viu. A lista inteira e o resto só a conta da igreja.
    match /equipe/{codigo} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas', 'indisponivel', 'entregas', 'vistoEm']);
    }

    // Escala de cada culto.
    match /escalas/{cultoId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // Planejamento: eventos (datas importantes e links) e demandas da equipe de mídia.
    match /eventos/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }
    match /demandas/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

        // Preferências de cada conta (as respostas prontas do diretor).
    match /perfis/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
