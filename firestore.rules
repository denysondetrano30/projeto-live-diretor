rules_version = '2';

// Projeto Live — regras do Firestore (Firebase › Firestore Database › Regras: cole tudo e Publique).
// Cada culto só pode ser lido e mexido pela conta dona dele (campo "owner").
service cloud.firestore {
  match /databases/{database}/documents {
    match /cultos/{cultoId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;

      // Histórico das versões publicadas.
      match /versoes/{n} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/cultos/$(cultoId)).data.owner == request.auth.uid;
      }
    }

    // Culto ao vivo: o que está no telão agora (a Projeção escreve) e os recados e sugestões.
    match /aoVivo/{cultoId} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;

      match /eventos/{id} {
        allow read, update: if request.auth != null
          && get(/databases/$(database)/documents/aoVivo/$(cultoId)).data.owner == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.owner == request.auth.uid
          && get(/databases/$(database)/documents/aoVivo/$(cultoId)).data.owner == request.auth.uid;
      }
    }

    // Banco de músicas da igreja: a Projeção sobe a biblioteca; o diretor busca e cadastra novas.
    match /musicas/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // Equipe de mídia: cada pessoa é um documento com um código longo e aleatório (o link pessoal).
    // Quem tem o link (sem login) lê o próprio documento e só pode mudar as respostas, os dias em que
    // não pode e quando viu. A lista inteira e o resto só a conta da igreja.
    match /equipe/{codigo} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas', 'indisponivel', 'entregas', 'vistoEm']);
    }

    // Escala de cada culto.
    match /escalas/{cultoId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // Planejamento: eventos (datas importantes e links) e demandas da equipe de mídia.
    match /eventos/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }
    match /demandas/{id} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // Celular sem app (somun cam pelo navegador): cada entrada do somun live tem um documento com um
    // código longo e aleatório (o QR code). O celular, sem login, lê o documento e só pode escrever o
    // pedido de conexão e a resposta dele. O resto (oferta, dono) só a conta da igreja.
    match /camParear/{codigo} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedido', 'resposta', 'respostaDe']);
    }

    // "Relatar problema" (25/11): qualquer programa do somun cria (sem login, como a cam no navegador),
    // só com os campos certos e tamanho limitado. Ler, marcar resolvido e apagar: só a conta da dona
    // do somun (página "Relatos" do Diretor).
    match /relatos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto', 'contato', 'app', 'versao', 'conta', 'sistema', 'registro', 'print', 'em', 'resolvido'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
        && request.resource.data.app is string && request.resource.data.app.size() <= 20
        && request.resource.data.em is timestamp
        && request.resource.data.resolvido == false
        && (!('contato' in request.resource.data) || (request.resource.data.contato is string && request.resource.data.contato.size() <= 200))
        && (!('versao' in request.resource.data) || (request.resource.data.versao is string && request.resource.data.versao.size() <= 60))
        && (!('conta' in request.resource.data) || (request.resource.data.conta is string && request.resource.data.conta.size() <= 200))
        && (!('sistema' in request.resource.data) || (request.resource.data.sistema is string && request.resource.data.sistema.size() <= 600))
        && (!('registro' in request.resource.data) || (request.resource.data.registro is string && request.resource.data.registro.size() <= 60000))
        && (!('print' in request.resource.data) || (request.resource.data.print is string && request.resource.data.print.size() <= 800000));
      allow read, update, delete: if dona();
    }

    // somun hub (25/11): quem administra o somun (a conta dela e a conta do somun).
    function dona() {
      return request.auth != null && request.auth.uid in ['Gjut8HQr4dbmeLRNdLZkvCgRT8e2', 'ggQHVFAQBzfUP9WtHDvu39o8sVn2'];
    }

    // Sinal de vida: cada conta grava só o próprio documento (quando usou o live, o tela e o Diretor,
    // e a versão instalada). A administração lê todos (painel somun hub); cada conta lê o seu (a
    // conferência antes do culto, no Diretor, vê se o live e o tela foram abertos hoje).
    match /sinais/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'live', 'tela', 'diretor']);
      allow read: if dona() || (request.auth != null && request.auth.uid == uid);
    }

    // Anotações da administração sobre cada igreja (painel somun hub).
    match /hubNotas/{uid} {
      allow read, write: if dona();
    }

        // Preferências de cada conta (as respostas prontas do diretor).
    match /perfis/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
